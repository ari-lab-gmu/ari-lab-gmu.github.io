---
import { Picture } from "astro:assets";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="flex flex-col md:flex-row items-center justify-center gap-8 pt-16 pb-8 md:pt-12 md:pb-12">
  <div>
    <Picture
      src="/images/nao_bye.png"
      alt="NAO Robot"
      width={140}
      height={140}
      loading="eager"
      class="w-[140px] h-auto"
    />
  </div>
  <div class="max-w-[1068px]">
    <h1
      class="text-4xl lg:text-5xl xl:text-6xl font-bold lg:tracking-tight xl:tracking-tighter">
      Autonomous Robot Interaction Laboratory
    </h1>
    <p class="text-base mt-4 text-slate-600">
      Investigating how people interact with autonomous robots.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">

    </div>
  </div>
</main>

<section class="py-16">
  <div class="max-w-(--breakpoint-xl) mx-auto">
    <h2 class="text-3xl lg:text-4xl font-bold mb-8">News</h2>
    <div class="space-y-0">
        <p class="text-gray-600"><b>> 1.26</b> Congrats to <a href="https://humanfactors.gmu.edu/">HFAC</a> students JP Tiger, Neha Kannan, Jacob Henley, and Paige Williamson on a successful <a href="/publications#nose-knows-2026">HRI Student Design</a> submission!</p>
        <p class="text-gray-600"><b>> 8.25</b> ARI Lab founded.</p>
    </div>
  </div>
</section>
