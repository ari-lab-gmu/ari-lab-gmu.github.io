---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// Filter publication entries with 'draft: false'
const publishedBlogEntries = await getCollection("publications", ({ data }) => {
  return !data.draft;
});

// Sort content entries by publication date
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

// Group entries by year
const entriesByYear = publishedBlogEntries.reduce((acc, entry) => {
  const year = new Date(entry.data.publishDate).getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(entry);
  return acc;
}, {} as Record<number, typeof publishedBlogEntries>);

const years = Object.keys(entriesByYear).map(Number).sort((a, b) => b - a);
---

<Layout title="Publications">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Publications</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>
    <p class="text-base mt-4 text-slate-600 text-center">
      Publications from the ARI Lab (George Mason University). Includes collaborative work with partner labs and intitutions.
    </p>
    <main class="mt-16">
      <div class="max-w-4xl mx-auto space-y-12">
        {years.map(year => (
          <div>
            <h2 class="text-2xl font-bold mb-6">{year}</h2>
            <ul class="grid gap-8">
              {entriesByYear[year].map((entry) => (
                <li id={entry.slug} class="border-l-4 border-blue-400 pl-6 transition-colors">
                  <h3 class="text-base font-semibold mb-0.5">
                    {entry.data.pdfUrl || entry.data.link ? (
                      <a href={entry.data.pdfUrl || entry.data.link} class="hover:text-blue-600 hover:underline">
                        {entry.data.title}
                      </a>
                    ) : (
                      entry.data.title
                    )}
                  </h3>
                  <p class="text-gray-700 leading-relaxed">
                    {entry.data.citation}
                    {entry.data.acceptanceRate && (
                      <span class="text-orange-600 ml-2">({entry.data.acceptanceRate} acceptance)</span>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </main>
  </Container>
</Layout>

<style>
  @keyframes highlight-fade {
    0% {
      background-color: rgb(253, 224, 71);
    }
    100% {
      background-color: transparent;
    }
  }

  .highlight-pulse {
    animation: highlight-fade 2s ease-out;
  }
</style>

<script>
  function handleHighlight() {
    const hash = window.location.hash.slice(1);
    if (hash) {
      const element = document.getElementById(hash);
      if (element) {
        setTimeout(() => {
          element.classList.add('highlight-pulse');
          element.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);
      }
    }
  }

  handleHighlight();
  window.addEventListener('hashchange', handleHighlight);
</script>
